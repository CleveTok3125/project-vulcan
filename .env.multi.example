# Multi-game session preset for one host.
#
# Copy it, create the catalog, and select the copy for every target:
#   cp .env.multi.example .env.multi
#   cp games.example.yaml games.yaml
#   make up P=.env.multi
#
# Lines marked "host:" depend on the machine rather than on a game.

# --- Session ---
SESSION_ID=multi
# Host file containing the game catalog. The Makefile converts it to
# .generated/games.json and .generated/compose.games.yaml.
GAMES_CATALOG=games.yaml

# --- Wine ---
# host: Wine tree mounted read-only at /data/spritz-wine-tkg. Wine 11 ships
# bin/wine; Spritz and Proton trees ship bin/wine64. A game can override this
# with wine_source in games.yaml.
SPRITZ_DIR=/path/to/spritz-wine-tkg
WINE_ROOT=/data/spritz-wine-tkg
UMU_USE_STEAM=1
# dxvk rewrites d3d11, dxgi, and d3d12; wined3d keeps Wine's own OpenGL path.
D3D_BACKEND=dxvk
WINEESYNC=1
WINEFSYNC=1
__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
# Shows shader compiler activity; other values include fps,frametimes.
DXVK_HUD=compiler
# host: directory with the DXVK DLLs, mounted read-only at /data/dxvk.
DXVK_HOST_DIR=/usr/share/dxvk

# Build-time: pin the capture layer to the host obs-vkcapture version.
OBS_VKCAPTURE_REF=v1.5.6
# Runtime: capture the Wine/game process into host OBS. Set 0 to disable.
# OBS_VKCAPTURE_NAME defaults to SESSION_ID-GAME_ID; set it to override.
OBS_VKCAPTURE=1
# AUDIO_RUNTIME_DIR defaults to /run/user/<uid>/vulcan/<SESSION_ID>.
# Fixed tunnel latency in ms; lower reduces delay, higher is safer.
AUDIO_LATENCY_MSEC=60

# --- Display ---
GAME_WIDTH=1920
GAME_HEIGHT=1080
GAME_FPS=144
GAMESCOPE_ENABLED=1
GAMESCOPE_RT=0
GAMESCOPE_GRAB_CURSOR=1
GAMESCOPE_HIDE_CURSOR_DELAY=86400000
GAMESCOPE_TOUCH_MODE=4
GAMESCOPE_FORCE_WINDOWS_FULLSCREEN=1

# --- Input ---
INPUT_TRANSPORT=socket
INPUT_GAMEPAD=1

# --- Encoder ---
GPU_VENDOR=nvidia
APOLLO_PKG=apollo-git
APOLLO_COMMIT=adc5c5a0bd80831ce495434bb16aee2cd4175fb8
APOLLO_ENCODER=nvenc
APOLLO_NAME=Vulcan-Multi
# Must be unique per running session; the web UI uses port + 1.
APOLLO_PORT=48006
APOLLO_OUTPUT=HEADLESS-1
# host: VAAPI only; leave empty for NVENC.
APOLLO_ADAPTER=
# host: NVIDIA device index passed to the driver.
NVIDIA_VISIBLE_DEVICES=0
# host: render node of the GPU that runs gamescope and the encoder. 0x10de is
# NVIDIA and 0x1002 is AMD; see "Fresh deployment" in README.md.
RENDER_NODE=/dev/dri/renderD128

# --- Host groups ---
# host: numeric GIDs. Read them with
#   stat -c '%g %n' /dev/input/event* /dev/dri/renderD128
#   getent group video
GID_RENDER=992
GID_VIDEO=986
# host: only needed when a game source is not readable by the game UID/GID.
GID_STORAGE=
