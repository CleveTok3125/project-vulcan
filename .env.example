# Copy to .env.local and fill with numeric host GIDs.
GAME_DIR=/srv/games/zzz
GAME_ID=zzz
GAME_APP_NAME=Zenless Zone Zero
# Leave empty to derive a stable UUID from GAME_ID.
GAME_APP_UUID=
# Game-relative paths cleared once per prefix, before the first launch.
GAME_RESET_PATHS=ZenlessZoneZero_Data/Persistent/LocalStorage:ZenlessZoneZero_Data/SDKCaches/HoYoPass
SPRITZ_DIR=/path/to/spritz-wine-tkg
GAME_EXE=/games/zzz/ZenlessZoneZero.exe
GAME_WIDTH=1920
GAME_HEIGHT=1080
GAME_FPS=144
GAMESCOPE_ENABLED=1
GAMESCOPE_RT=0
GAMESCOPE_GRAB_CURSOR=1
GAMESCOPE_HIDE_CURSOR_DELAY=86400000
GAMESCOPE_TOUCH_MODE=4
GAMESCOPE_FORCE_WINDOWS_FULLSCREEN=1
INPUT_EXTRA_NAMES=Sunshine X-Box One (virtual) pad,Sunshine PS5 (virtual) pad,Sunshine Nintendo (virtual) pad
INPUT_BACKEND=native
INPUT_TRANSPORT=socket
INPUT_GAMEPAD=1
INPUT_DISPLAY=
GPU_VENDOR=nvidia
INSTALL_CUDA=1
APOLLO_PKG=apollo-git
APOLLO_COMMIT=adc5c5a0bd80831ce495434bb16aee2cd4175fb8
NVIDIA_VISIBLE_DEVICES=0
APOLLO_ENCODER=nvenc
APOLLO_ADAPTER=
APOLLO_NAME=Vulcan-ZZZ
APOLLO_PORT=47989
APOLLO_OUTPUT=HEADLESS-1
# Render node of the encoder GPU; see "Fresh deployment" in README.md.
RENDER_NODE=
WINE_ROOT=/data/spritz-wine-tkg
UMU_USE_STEAM=1
D3D_BACKEND=dxvk
DXVK_HOST_DIR=/usr/share/dxvk

GID_INPUT=993
GID_RENDER=992
GID_VIDEO=986
GID_STORAGE=
