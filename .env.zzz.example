# Zenless Zone Zero preset for one host.
#
# Copy it and select the copy for every target:
#   cp .env.zzz.example .env.zzz
#   make up PRESET=.env.zzz
#
# Lines marked "host:" depend on the machine rather than on the game.

# --- Game identity ---
# Host directory mounted read-only at /games-ro/<GAME_ID>.
GAME_DIR=/srv/games/zzz
# Names the mount points, the overlay directory, the data volume
# vulcan_<GAME_ID>-data, and the default Apollo host name Vulcan-<GAME_ID>.
GAME_ID=zzz
# App label shown to streaming clients.
GAME_APP_NAME=Zenless Zone Zero
# Empty derives a stable UUID from GAME_ID; set the stored value to keep the
# per-app state that clients already saved.
GAME_APP_UUID=
# ZZZ only: the host tree keeps the stored sign-in, logs, and telemetry from
# earlier runs. Clear them once per prefix so a new prefix starts signed out.
# Paths are relative to GAME_DIR and separated by ':'.
GAME_RESET_PATHS=ZenlessZoneZero_Data/Persistent/LocalStorage:ZenlessZoneZero_Data/Persistent/LogDir:ZenlessZoneZero_Data/SDKCaches/HoYoPass:ZenlessZoneZero_Data/SDKCaches/telemetry
# ZZZ only: a fresh prefix makes the game install its HoYoKProtect driver. The
# first launches then abort while loading MHYPBase.dll; start the app again
# from the client and a later launch reaches the game.
# Executable inside the writable overlay view, not inside GAME_DIR.
GAME_EXE=/games/zzz/ZenlessZoneZero.exe

# --- Wine ---
# host: Wine tree mounted read-only at /data/spritz-wine-tkg. Wine 11 ships
# bin/wine; Spritz and Proton trees ship bin/wine64.
SPRITZ_DIR=/path/to/spritz-wine-tkg
WINE_ROOT=/data/spritz-wine-tkg
UMU_USE_STEAM=1
# dxvk rewrites d3d11, dxgi, and d3d12; wined3d keeps Wine's own OpenGL path.
D3D_BACKEND=dxvk
WINEESYNC=1
WINEFSYNC=1
__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
# Shows shader compiler activity; other values include fps,frametimes.
DXVK_HUD=compiler
# host: directory with the DXVK DLLs, mounted read-only at /data/dxvk.
DXVK_HOST_DIR=/usr/share/dxvk

# --- Display ---
GAME_WIDTH=1920
GAME_HEIGHT=1080
GAME_FPS=144
GAMESCOPE_ENABLED=1
GAMESCOPE_RT=0
GAMESCOPE_GRAB_CURSOR=1
GAMESCOPE_HIDE_CURSOR_DELAY=86400000
GAMESCOPE_TOUCH_MODE=4
GAMESCOPE_FORCE_WINDOWS_FULLSCREEN=1

# --- Input ---
INPUT_TRANSPORT=socket
INPUT_BACKEND=native
INPUT_GAMEPAD=1
INPUT_DISPLAY=
INPUT_EXTRA_NAMES=Sunshine X-Box One (virtual) pad,Sunshine PS5 (virtual) pad,Sunshine Nintendo (virtual) pad

# --- Encoder ---
GPU_VENDOR=nvidia
APOLLO_PKG=apollo-git
APOLLO_COMMIT=adc5c5a0bd80831ce495434bb16aee2cd4175fb8
APOLLO_ENCODER=nvenc
APOLLO_NAME=Vulcan-ZZZ
# Must be unique per running session; the web UI uses port + 1.
APOLLO_PORT=47989
APOLLO_OUTPUT=HEADLESS-1
# host: VAAPI only; leave empty for NVENC.
APOLLO_ADAPTER=
# host: NVIDIA device index passed to the driver.
NVIDIA_VISIBLE_DEVICES=0
# host: render node of the GPU that runs gamescope and the encoder. 0x10de is
# NVIDIA and 0x1002 is AMD; see "Fresh deployment" in README.md.
RENDER_NODE=/dev/dri/renderD128

# --- Host groups ---
# host: numeric GIDs. Read them with
#   stat -c '%g %n' /dev/input/event* /dev/dri/renderD128
#   getent group video
GID_INPUT=993
GID_RENDER=992
GID_VIDEO=986
# host: only needed when GAME_DIR is not readable by the game UID/GID.
GID_STORAGE=
