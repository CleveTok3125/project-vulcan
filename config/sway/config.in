# Vulcan headless Sway configuration.

output HEADLESS-1 resolution @MODE@ position 0 0
swaybg_command /usr/local/bin/swaybg-vulcan.sh

output HEADLESS-1 bg /usr/share/vulcan/wallpaper.png fill

default_border none
default_floating_border none
hide_edge_borders both
gaps inner 0
gaps outer 0
focus_follows_mouse no
mouse_warping none

xwayland enable

# gamescope is the only visible client. It also requests fullscreen itself.
for_window [app_id="gamescope"] fullscreen enable
for_window [class="gamescope"] fullscreen enable

exec_always /usr/local/bin/session-start.sh
