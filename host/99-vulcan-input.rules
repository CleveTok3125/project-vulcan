# Host udev rules for Vulcan game containers.
#
# Install as /etc/udev/rules.d/99-vulcan-input.rules and run:
#   udevadm control --reload-rules
#   udevadm trigger --subsystem-match=input
#
# The uinput/uhid nodes are shared with the container through Docker. The
# container user must be a member of the numeric GID of the "uinput" group.
# Keyboard and mouse devices created by inputtino are moved to a separate seat
# so the host compositor does not react to streamed input.

KERNEL=="uinput", GROUP="uinput", MODE="0660"
KERNEL=="uhid", GROUP="uinput", MODE="0660"

SUBSYSTEM=="input", ATTRS{name}=="*passthrough*", ENV{ID_SEAT}="seat-vulcan", MODE="0660", GROUP="input"
